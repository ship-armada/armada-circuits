{
  "name": "@armada/circuits",
  "version": "0.0.1",
  "description": "Armada custom zero-knowledge circuits (Groth16/BN254)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "compile": "bash scripts/compile.sh",
    "setup:dev": "bash scripts/setup-dev.sh",
    "test": "bash scripts/test.sh",
    "lint:circom": "circomspect src/**/*.circom || true",
    "clean": "rm -rf build/*",
    "ceremony:ptau": "bash scripts/ceremony/fetch-ptau.sh",
    "ceremony:init": "bash scripts/ceremony/init.sh",
    "ceremony:contribute": "bash scripts/ceremony/contribute.sh",
    "ceremony:verify": "bash scripts/ceremony/verify.sh",
    "ceremony:finalize": "bash scripts/ceremony/finalize.sh",
    "ceremony:test": "bash scripts/ceremony/test-e2e.sh"
  },
  "devDependencies": {
    "circom2": "^0.2.18",
    "circomlib": "^2.0.5",
    "snarkjs": "^0.7.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
